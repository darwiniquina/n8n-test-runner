{
  "name": "n8n-test-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Run saved test scenarios against an n8n instance, Postman style, from the command line.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "n8nt": "node src/cli.ts",
    "example": "node src/cli.ts run examples/scenarios --config examples/n8nt.config.yaml",
    "example:harness": "node src/cli.ts run examples/harness-scenarios --config examples/n8nt.config.yaml",
    "dev:ui": "vite ui",
    "build:ui": "vite build ui",
    "test": "node --test \"src/**/*.test.ts\" \"ui/src/**/*.test.ts\"",
    "typecheck": "tsc && tsc -p ui"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "codemirror": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
